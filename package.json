{
  "name": "codeflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeFlow application shell — build/dev tooling. See README.md for the app itself and card/ for the GitHub Action.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run setup:codevisualizer && node scripts/generate-build-info.mjs && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.mjs",
    "setup:codevisualizer": "node scripts/setup-codevisualizer-core.mjs",
    "preinstall": "npm run setup:codevisualizer",
    "postinstall": "node scripts/install-pyan3.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@codevisualizer/core": "file:.vendor/codevisualizer/packages/core",
    "acorn": "^8.17.0",
    "tree-sitter-wasms": "0.1.13",
    "ts-graphviz": "3.0.7",
    "web-tree-sitter": "0.20.8"
  }
}
